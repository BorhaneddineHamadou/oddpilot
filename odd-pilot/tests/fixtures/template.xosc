  <FileHeader revMajor="1" revMinor="2" date="2026-07-21T12:00:00"
              description="odd-pilot plan template" author="odd-pilot"/>
  <ParameterDeclarations>
    <ParameterDeclaration name="weather" parameterType="string" value="dry"/>
    <ParameterDeclaration name="road" parameterType="string" value="dry"/>
    <ParameterDeclaration name="time" parameterType="string" value="day"/>
  </ParameterDeclarations>
  <Entities>
    <ScenarioObject name="ego">
      <Vehicle name="car" vehicleCategory="car" mass="1600">
        <BoundingBox><Center x="0" y="0" z="0"/>
